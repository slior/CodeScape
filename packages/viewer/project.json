{
  "name": "viewer",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/viewer/src",
  "projectType": "library",
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p tsconfig.spec.json",
        "cwd": "packages/viewer"
      },
      "cache": true
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint .",
        "cwd": "packages/viewer"
      },
      "cache": true
    },
    "test": {
      "executor": "@sw3d/viewer:test",
      "options": {},
      "cache": true
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vite build",
        "cwd": "packages/viewer"
      },
      "outputs": ["{projectRoot}/dist"],
      "cache": true
    }
  },
  "tags": []
}
